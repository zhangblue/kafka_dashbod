# Build only: the scratch stage exports one file, not a runtime image.
FROM --platform=linux/amd64 rust:1-alpine AS builder
# librdkafka 2.12.1 includes curl/curl.h under #ifdef for an option defined as 0
# by CMake. Headers are build-only; the Cargo curl feature remains disabled.
RUN apk add --no-cache build-base musl-dev cmake make perl pkgconf linux-headers curl-dev
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo build --locked --release --target x86_64-unknown-linux-musl -p backend --bin kafka-dashboard

FROM scratch AS artifact
COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/kafka-dashboard /kafka-dashboard-linux-amd64
